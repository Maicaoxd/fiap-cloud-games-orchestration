{
  "uid": "fcg-apis",
  "title": "FIAP Cloud Games - APIs",
  "tags": [
    "fiap",
    "fcg",
    "observabilidade"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "API",
        "type": "custom",
        "query": "users-api,catalog-api",
        "multi": true,
        "includeAll": true,
        "allValue": "users-api|catalog-api",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "users-api",
            "value": "users-api"
          },
          {
            "selected": false,
            "text": "catalog-api",
            "value": "catalog-api"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidade da coleta",
      "description": "1 = scrape bem-sucedido; 0 = falha de coleta. Nao substitui readiness SQL/RabbitMQ.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "afy2txliwdngge"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"${service:regex}\"}",
          "instant": true,
          "range": false,
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total de requisicoes",
      "description": "Contador desde a inicializacao de cada processo. Reiniciar a API zera o contador.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "afy2txliwdngge"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (job) (http_requests_received_total{job=~\"${service:regex}\"}) or on(job) (0 * sum by (job) (up{job=~\"${service:regex}\"})))",
          "instant": true,
          "range": false,
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Requisicoes por segundo",
      "description": "Taxa media nos ultimos cinco minutos. Exclui health checks e scrapes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "afy2txliwdngge"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (job) (rate(http_requests_received_total{job=~\"${service:regex}\"}[5m])) or on(job) (0 * sum by (job) (up{job=~\"${service:regex}\"})))",
          "instant": false,
          "range": true,
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Respostas por status HTTP",
      "description": "Somente respostas das APIs. Erros bloqueados pelo Kong nao chegam aqui.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "afy2txliwdngge"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, code) (rate(http_requests_received_total{job=~\"${service:regex}\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{job}} HTTP {{code}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Erros 5xx (%)",
      "description": "Percentual de respostas 5xx em cinco minutos; sem trafego, mostra zero.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "afy2txliwdngge"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum by (job) (rate(http_requests_received_total{job=~\"${service:regex}\",code=~\"5..\"}[5m])) or on(job) (0 * sum by (job) (up{job=~\"${service:regex}\"}))) / clamp_min((sum by (job) (rate(http_requests_received_total{job=~\"${service:regex}\"}[5m])) or on(job) (0 * sum by (job) (up{job=~\"${service:regex}\"}))), 0.000001)",
          "instant": false,
          "range": true,
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Latencia p95",
      "description": "95% das requisicoes ficam abaixo deste tempo estimado pelo histograma. Sem amostras, pode mostrar No data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "afy2txliwdngge"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket{job=~\"${service:regex}\"}[5m])))",
          "instant": false,
          "range": true,
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Memoria do processo",
      "description": "Memoria residente do processo da API; nao e a memoria total do container.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "afy2txliwdngge"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_working_set_bytes{job=~\"${service:regex}\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
